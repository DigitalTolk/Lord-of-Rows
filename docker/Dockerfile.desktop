# Runs the Linux build of DB Studio on a virtual display, viewable in a browser via noVNC.
# For previewing only; macOS/Windows builds must be produced on those platforms.
FROM dbstudio-dev:latest
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      x11vnc novnc websockify fluxbox fonts-dejavu fonts-noto-color-emoji imagemagick \
  && rm -rf /var/lib/apt/lists/*
COPY desktop-entry.sh /usr/local/bin/desktop-entry.sh
RUN chmod +x /usr/local/bin/desktop-entry.sh
CMD ["/usr/local/bin/desktop-entry.sh"]
